{
  "name": "wisp-agents",
  "version": "0.1.0",
  "description": "Launch coding agents, skip the transcript, read the presentation.",
  "type": "module",
  "bin": {
    "wisp": "bin/wisp.js",
    "wisp-agents": "bin/wisp.js"
  },
  "files": [
    "bin/",
    "server/",
    "web/"
  ],
  "scripts": {
    "start": "node bin/wisp.js",
    "app": "electron .",
    "dev": "WISP_DEV=1 electron .",
    "dev:web": "node --watch-path=server bin/wisp.js --no-open",
    "prepublishOnly": "node --check bin/wisp.js && node -e \"import('./server/index.js')\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "coding-agent",
    "ai",
    "agents",
    "cli",
    "launcher"
  ],
  "author": "M0xoo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M0xoo/wisp.git"
  },
  "homepage": "https://github.com/M0xoo/wisp#readme",
  "bugs": {
    "url": "https://github.com/M0xoo/wisp/issues"
  },
  "main": "electron/main.js",
  "devDependencies": {
    "electron": "^44.8.0"
  }
}
