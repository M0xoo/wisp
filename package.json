{
  "name": "wisp-workspace",
  "private": true,
  "type": "module",
  "description": "wisp v2: the monorepo. The published package is apps/server (wisp-agents).",
  "workspaces": [
    "packages/*",
    "plugins/*/api",
    "plugins/*/host",
    "plugins/*/ui",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node tools/test.ts",
    "test:v1": "node scripts/test.mjs",
    "check": "node tools/check/index.ts",
    "typecheck": "node tools/typecheck.ts",
    "verify": "npm run check && npm run typecheck && npm test",
    "build": "npm run build --workspace @wisp/web && node tools/bundle.ts",
    "dev": "node tools/dev.ts",
    "dev:web": "npm run dev --workspace @wisp/web",
    "budgets": "node tools/budgets.ts",
    "start": "node apps/server/bin/wisp.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
