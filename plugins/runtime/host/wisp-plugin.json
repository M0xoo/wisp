{
  "wispPlugin": 1,
  "id": "wisp.runtime",
  "name": "Tasks",
  "version": "2.0.0",
  "api": "1",
  "description": "Tasks (sessions), their turns and activity, the follow-up queue and the harness lifecycle",
  "author": "wisp",
  "kind": "plugin",
  "provides": {
    "runtime.harness": {
      "version": "1.0.0"
    },
    "runtime.summary": {
      "version": "1.0.0"
    },
    "runtime.prompt": {
      "version": "1.0.0"
    },
    "runtime.block": {
      "version": "1.0.0"
    },
    "runtime.view": {
      "version": "1.0.0"
    },
    "runtime.after": {
      "version": "1.0.0"
    },
    "runtime.run": {
      "version": "1.0.0"
    },
    "runtime.outcome": {
      "version": "1.0.0"
    },
    "runtime.delegate": {
      "version": "1.0.0"
    },
    "runtime.accounts": {
      "version": "1.0.0"
    }
  },
  "permissions": [
    "router:read",
    "router:write",
    "stuff:read",
    "fs:read{path:~/.wisp/sessions}",
    "fs:write{path:~/.wisp/sessions}",
    "proc:exec{bin:*}",
    "proc:spawn{bin:*}",
    "store:write{owner:runtime}",
    "telemetry:track",
    "worktrees:create",
    "accounts:write",
    "terminal:open"
  ],
  "server": {
    "builtin": "wisp-runtime"
  },
  "activation": [
    "onStartup"
  ],
  "migrations": "runtime",
  "contributes": {
    "events": [{"type": "session.asked", "durable": true}, "session.changed", "session.created", "session.deleted", "turn.activity", {"type": "turn.ended", "durable": true}, {"type": "turn.finished", "durable": true}, {"type": "turn.held", "durable": true}, "turn.limits", "turn.started", {"type": "task.finished", "durable": true}, {"type": "task.failed", "durable": true}, {"type": "task.held", "durable": true}, {"type": "task.asked", "durable": true}, {"type": "task.done", "durable": true}],
    "commands": [
      {
        "id": "runtime.create",
        "title": "Start a task"
      },
      {
        "id": "runtime.followUp",
        "title": "Send a task a follow-up"
      },
      {
        "id": "runtime.stop",
        "title": "Stop a task's turn"
      },
      {
        "id": "runtime.rename",
        "title": "Rename a task"
      },
      {
        "id": "runtime.archive",
        "title": "Archive or unarchive a task"
      },
      {
        "id": "runtime.markRead",
        "title": "Mark a task read or unread"
      },
      {
        "id": "runtime.setState",
        "title": "Set a task's state"
      },
      {
        "id": "runtime.delete",
        "title": "Delete a task"
      },
      {
        "id": "runtime.queue.edit",
        "title": "Edit a queued follow-up"
      },
      {
        "id": "runtime.queue.sendNow",
        "title": "Send a queued follow-up now"
      },
      {
        "id": "runtime.queue.merge",
        "title": "Merge queued follow-ups into one"
      },
      {
        "id": "runtime.queue.text",
        "title": "Change a queued follow-up's text"
      },
      {
        "id": "runtime.release",
        "title": "Release a held task"
      },
      { "id": "runtime.held", "title": "Start or skip a task's held turn" },
      { "id": "runtime.setMode", "title": "Set the mode a task's next turns run in" },
      { "id": "runtime.setAgent", "title": "Set the harness a task's next turns run on" },
      { "id": "runtime.forLater", "title": "Save a task for later, or take it out" },
      { "id": "runtime.queue.order", "title": "Reorder a task's queued follow-ups" },
      { "id": "runtime.queue.cancel", "title": "Take a queued follow-up out" },
      {
        "id": "runtime.get",
        "title": "A task",
        "readOnly": true
      },
      {
        "id": "runtime.list",
        "title": "The task list",
        "readOnly": true
      },
      {
        "id": "runtime.turns",
        "title": "A task's turns",
        "readOnly": true
      },
      {
        "id": "runtime.activity",
        "title": "A task's activity",
        "readOnly": true
      },
      {
        "id": "runtime.cold",
        "title": "A large idle task's prompt cache: gone cold or not, and what Compact now would cost",
        "readOnly": true
      },
      {
        "id": "runtime.presentation",
        "title": "A task's presentation",
        "readOnly": true
      },
      {
        "id": "runtime.setExt",
        "title": "Set a plugin's slot on a task"
      },
      {
        "id": "runtime.turn.setExt",
        "title": "Set a plugin's slot on a turn"
      },
      {
        "id": "runtime.note",
        "title": "Add a note to a task"
      },
      {
        "id": "runtime.settle",
        "title": "Settle a task that stopped"
      },
      {
        "id": "runtime.search",
        "title": "Search tasks",
        "readOnly": true
      },
      {
        "id": "runtime.agents",
        "title": "The harnesses a task can run on",
        "readOnly": true
      },
      {
        "id": "runtime.card",
        "title": "Add a card to the list"
      },
      {
        "id": "runtime.import",
        "title": "Import v1's tasks"
      },
      {
        "id": "runtime.ask",
        "title": "An agent asks the user a question"
      },
      {
        "id": "runtime.answer",
        "title": "Answer an agent's question"
      },
      {
        "id": "runtime.pollAnswer",
        "title": "Has the question been answered",
        "readOnly": true
      },
      {
        "id": "runtime.approval",
        "title": "A live approval of a tool call"
      },
      {
        "id": "runtime.approveBlocked",
        "title": "Allow what the last turn's permissions blocked"
      },
      {
        "id": "runtime.btw",
        "title": "A side question on a copy of the conversation"
      },
      {
        "id": "runtime.btw.drop",
        "title": "Drop a side question"
      },
      {
        "id": "runtime.compact",
        "title": "Compact the conversation"
      },
      {
        "id": "runtime.rerun",
        "title": "Run a signed-out turn again"
      },
      {
        "id": "runtime.fork",
        "title": "Fork the task from a turn"
      },
      {
        "id": "runtime.delegate",
        "title": "Start subagents"
      },
      {
        "id": "runtime.results",
        "title": "Subagents' reports",
        "readOnly": true
      },
      {
        "id": "runtime.quick",
        "title": "One answer from a harness, outside any task"
      },
      {
        "id": "runtime.signIn",
        "title": "Rerun this turn when its sign-in lands"
      },
      {
        "id": "runtime.signInDone",
        "title": "A sign-in finished"
      },
      {
        "id": "runtime.overage",
        "title": "A turn billed past its plan"
      },
      {
        "id": "runtime.agent.sessions",
        "title": "An agent lists the user's tasks (wisp_sessions)",
        "readOnly": true
      },
      {
        "id": "runtime.agent.session",
        "title": "An agent reads a task (wisp_session)",
        "readOnly": true
      },
      {
        "id": "runtime.profiles",
        "title": "Agent profiles",
        "readOnly": true
      },
      {
        "id": "runtime.profile.set",
        "title": "Add or change an agent profile"
      },
      {
        "id": "runtime.profile.remove",
        "title": "Remove an agent profile"
      },
      {
        "id": "runtime.spec",
        "title": "A task's spec: what was asked, from which code, under which formula",
        "readOnly": true
      },
      {
        "id": "runtime.snapshot",
        "title": "The formula a task ran with",
        "readOnly": true
      },
      {
        "id": "runtime.history",
        "title": "Tasks by what made them",
        "readOnly": true
      },
      {
        "id": "runtime.adopt",
        "title": "Import a shared task, read-only"
      },
      {
        "id": "runtime.projectRun",
        "title": "Run a project's run scripts"
      },
      {
        "id": "runtime.exec",
        "title": "Run a one-click command from a presentation in the task's folder"
      },
      {
        "id": "runtime.appState",
        "title": "Keep an app block's state on its turn"
      },
      {
        "id": "runtime.usage",
        "title": "Spend, turns, how many worked and questions asked over the last days",
        "readOnly": true
      },
      {
        "id": "runtime.projectTest",
        "title": "Set the command that runs a project's tests"
      }
    ],
    "topics": [
      "list",
      "session:<id>"
    ],
    "settings": [
      {
        "key": "runtime.retentionDays",
        "type": "int",
        "default": 0,
        "min": 0,
        "title": "Days a finished task stays in the list before it's archived (0: always)"
      }
    ]
  }
}
