{
  "wispPlugin": 1,
  "id": "wisp.plugins",
  "name": "Plugins",
  "version": "2.0.0",
  "api": "^1",
  "description": "The plugin manager: which plugins this wisp has, switching them on and off (the plugin kind)",
  "server": {
    "builtin": "wisp-plugins"
  },
  "permissions": [
    "plugins:manage"
  ],
  "activation": [
    "onStartup"
  ],
  "contributes": {
    "commands": [
      {
        "id": "plugins.list",
        "title": "Which plugins this wisp has",
        "readOnly": true
      },
      {
        "id": "plugins.setEnabled",
        "title": "Switch a plugin on or off"
      }
    ]
  }
}
