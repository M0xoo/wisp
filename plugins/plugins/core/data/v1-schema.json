 "slots": [
  [
   "topbar",
   "The top bar, next to Automations and Search: a labelled button with an optional count."
  ],
  [
   "float",
   "Floating buttons, stacked in a bottom corner of the window. Buttons with the same group fold into one that fans out."
  ],
  [
   "palette",
   "An item in the ⌘K palette."
  ],
  [
   "feed.top",
   "Above the feed: a panel pinned there (panels only)."
  ],
  [
   "launcher.bar",
   "In the prompt box bar, before Send."
  ],
  [
   "launcher.chips",
   "Chips under the prompt box (chips and buttons)."
  ],
  [
   "composer.bar",
   "In a card's follow-up box bar, before Send."
  ],
  [
   "composer.chips",
   "Chips above a card's follow-up box (quick replies)."
  ],
  [
   "card.head",
   "A chip in a card's head, before the time."
  ],
  [
   "card.hover",
   "A small icon button on a card head, shown on hover."
  ],
  [
   "card.menu",
   "An item in a card's right-click menu."
  ],
  [
   "card.top",
   "A panel at the top of an open card (panels only)."
  ],
  [
   "card.bottom",
   "A panel at the bottom of an open card, above the follow-up box (panels only)."
  ],
  [
   "sidebar.top",
   "Split view: a button at the top of the task list, next to New task."
  ],
  [
   "split.head",
   "Split view: a button in the open task's header, next to its title (acts on that task)."
  ],
  [
   "split.details",
   "Split view: a button in the open task's details column, under its actions (acts on that task)."
  ],
  [
   "term.head",
   "A button in the header of a task's terminal (take over in wisp), before End (acts on that task)."
  ],
  [
   "panel.head",
   "The side panel beside the open task (Changes, PR, Shell, Preview, Watch): a button in its head (acts on that task)."
  ],
  [
   "crew.page",
   "A crew member's thread: a button in its header, next to Pause."
  ],
  [
   "crew.rail",
   "The crew rail beside the task list (side by side): an icon button above Org and Add a crew member."
  ],
  [
   "org.head",
   "The Org page (who on the crew hands work to whom): a button in its header, before Add member."
  ],
  [
   "plan.head",
   "A scheduled task's page (opened from its row under Scheduled): a button in its header, before Start now."
  ],
  [
   "stuff.head",
   "My Stuff (what you and your agents kept from tasks): a button in its header, before Add files."
  ],
  [
   "split.panes",
   "Split view's home: a button on the Panes heading (the apps pinned on home)."
  ],
  [
   "split.upcoming",
   "Split view's home: a button on the Coming up heading (scheduled tasks, reminders, follow-ups, check-ins)."
  ],
  [
   "goal.band",
   "The open task's goal band: a button on its second line, after the last check (acts on that task)."
  ],
  [
   "machine.head",
   "Settings → This Mac (This PC, This computer): a button at the top of the pane, beside when it was last read."
  ]
