 "actions": [
  [
   "open",
   "safe",
   "{ \"open\": \"https://…/{pr.number}\" } open one http(s) link (a {field} template)"
  ],
  [
   "openAll",
   "safe",
   "{ \"openAll\": { \"data\": \"prs\", \"field\": \"url\" } } open every link in a data source (at most 20). Or { \"fn\": \"name\" }: a script function returning links, each of which must appear in the spell's data"
  ],
  [
   "panel",
   "safe",
   "{ \"panel\": \"id\" } open one of this spell's panels"
  ],
  [
   "insert",
   "safe",
   "{ \"insert\": \"text\" } put text into the box at the caret (prompt box or follow-up box)"
  ],
  [
   "copy",
   "safe",
   "{ \"copy\": \"{branch}\" } copy text"
  ],
  [
   "toast",
   "safe",
   "{ \"toast\": \"text\" } show a short message"
  ],
  [
   "setLaunch",
   "safe",
   "{ \"setLaunch\": { \"agent\": \"codex\", \"model\": \"\", \"effort\": \"high\", \"mode\": \"plan\" } } set the prompt box pickers"
  ],
  [
   "send",
   "acts",
   "{ \"send\": \"text\" } send a follow-up to the card's task right away"
  ],
  [
   "reply",
   "acts",
   "{ \"reply\": \"text\" } same as send, used by hooks"
  ],
  [
   "launchWith",
   "acts",
   "{ \"launchWith\": { \"agent\": \"codex\", \"mode\": \"plan\", \"effort\": \"high\", \"text\": \"optional prefix\" } } launch what is in the prompt box with these settings"
  ],
  [
   "launch",
   "acts",
   "{ \"launch\": { \"prompt\": \"…\", \"agent\": \"\", \"mode\": \"plan\", \"cwd\": \"\" } } start a new task (cwd empty = the current project)"
  ],
  [
   "rerun",
   "acts",
   "{ \"rerun\": { \"agent\": \"codex\", \"model\": \"\", \"effort\": \"\", \"mode\": \"plan\", \"prompt\": \"optional, defaults to the task's first request\" } } run the card's task again as a new task on another harness"
  ],
  [
   "fork",
   "acts",
   "{ \"fork\": { \"prompt\": \"Try it with a lookup table instead\", \"agent\": \"\", \"model\": \"\", \"effort\": \"\", \"mode\": \"\" } } fork the card's task from its latest turn: a new task with its conversation and a copy of its work, on its own branch, that does what prompt says (agent, model, effort, mode: optional, the task's own by default)"
  ],
  [
   "side",
   "acts",
   "{ \"side\": { \"prompt\": \"Review what it changed so far\", \"agent\": \"\", \"model\": \"\", \"effort\": \"\" } } start a side discussion about the card's task (as /side does): a read-only task of its own, on a page of its own, that reads the task's work and hears its latest state with every message, and changes nothing (agent, model, effort: optional, the task's own by default)"
  ],
  [
   "recipe",
   "acts",
   "{ \"recipe\": \"name\" } run a recipe"
  ],
  [
   "ship",
   "acts",
   "{ \"ship\": true } open Ship it for the card's task"
  ],
  [
   "done",
   "acts",
   "{ \"done\": true } mark the card's task done"
  ],
  [
   "archive",
   "acts",
   "{ \"archive\": true } archive the card's task"
  ],
  [
   "compact",
   "acts",
   "{ \"compact\": true } compact the card's task now: a large Claude task whose cache is still warm (refused otherwise). Buttons only: never from a hook"
  ],
  [
   "forLater",
   "acts",
   "{ \"forLater\": true } save the card's task for later (a finished one; it leaves Needs you for For later)"
  ],
  [
   "notify",
   "acts",
   "{ \"notify\": \"text\" } a desktop notification / toast (hooks: your phone, if linked)"
  ],
  [
   "webhook",
   "runs",
   "{ \"webhook\": \"https://…\" } POST the task summary as JSON to a URL (hooks)"
  ],
  [
   "exec",
   "runs",
   "{ \"exec\": \"npm run e2e\" } run a shell command in the task's folder (asks you the first time)"
  ]
 ],
