{
  "wispPlugin": 1,
  "id": "wisp.history",
  "name": "History",
  "version": "2.0.0",
  "api": "^1",
  "description": "A repo's agent history in .wisp/: track, blame, offers, resume requests, context injection (ADR-0033, 0042)",
  "kind": "plugin",
  "server": { "builtin": "wisp_history" },
  "provides": { "history.store": { "version": "1.0.0" }, "history.blame": { "version": "1.0.0" } },
  "permissions": ["runtime:get", "runtime:spec", "runtime:turns", "runtime:setExt", "runtime:create", "share:make", "proc:exec{bin:*}"],
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "history.track", "title": "Save a task into its repo's .wisp/" },
      { "id": "history.save", "title": "Save to repo (an offered task)" },
      { "id": "history.untrack", "title": "Take a task out of the repo's history" },
      { "id": "history.blame", "title": "Which task made this", "readOnly": true },
      { "id": "history.resumeRequest", "title": "Ask to resume an earlier task" },
      { "id": "history.resumeAnswer", "title": "Approve or deny a resume request" },
      { "id": "history.requests", "title": "Resume requests", "readOnly": true },
      { "id": "history.list", "title": "The repo's committed agent history (the Repo tab, wisp ls --repo)", "readOnly": true },
      { "id": "history.report", "title": "A tracked task's report and what was asked", "readOnly": true }
    ]
  }
}
