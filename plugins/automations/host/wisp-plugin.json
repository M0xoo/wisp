{
  "wispPlugin": 1,
  "id": "wisp.automations",
  "name": "automations",
  "version": "2.0.0",
  "api": "^1",
  "description": "triggers, watchers, recipes, cron schedules, inbound webhooks",
  "kind": "plugin",
  "server": {
    "builtin": "wisp_automations"
  },
  "permissions": [
    "runtime:create",
    "store:write{owner:automations}"
  ],
  "requires": {},
  "provides": {},
  "contributes": {
    "commands": [
      {
        "id": "automations.tasks",
        "title": "Declared tasks",
        "readOnly": true
      },
      {
        "id": "automations.task.set",
        "title": "Declare a task"
      },
      {
        "id": "automations.task.remove",
        "title": "Remove a declared task"
      },
      {
        "id": "automations.task.run",
        "title": "Run a declared task"
      }
    ]
  },
  "activation": [
    "onStartup"
  ]
}
