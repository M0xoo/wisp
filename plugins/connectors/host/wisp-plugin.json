{
  "wispPlugin": 1,
  "id": "wisp.connectors",
  "name": "Connectors",
  "version": "2.0.0",
  "api": "^1",
  "description": "MCP servers you add once in Settings, handed to every task's agent whatever the harness. Their secrets stay in the secrets file.",
  "server": { "builtin": "@wisp-plugin/connectors" },
  "requires": { "wisp.runtime": "^2", "connectors.bridge": { "version": "^1", "optional": true } },
  "permissions": ["runtime:get", "proc:spawn", "net:connect", "secrets:connector", "http:route"],
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "connectors.list", "title": "List connectors" },
      { "id": "connectors.add", "title": "Add a connector", "optimistic": "none" },
      { "id": "connectors.update", "title": "Change a connector", "optimistic": "none" },
      { "id": "connectors.remove", "title": "Remove a connector", "optimistic": "none" },
      { "id": "connectors.test", "title": "Test a connector", "optimistic": "none" },
      { "id": "connectors.import", "title": "Import connectors from the harnesses' configs", "optimistic": "none" },
      { "id": "connectors.signin", "title": "Sign in to a connector", "optimistic": "none" },
      { "id": "connectors.signout", "title": "Sign out of a connector", "optimistic": "none" },
      { "id": "connectors.oauthFinish", "title": "Finish a connector's sign-in", "optimistic": "none" },
      { "id": "connectors.token", "title": "A connector's fresh OAuth token (the proxy)", "optimistic": "none" },
      { "id": "connectors.spec", "title": "What the proxy runs for a connector" },
      { "id": "connectors.forTurn", "title": "The MCP servers a turn gets" },
      { "id": "connectors.agent.list", "title": "wisp_connectors" },
      { "id": "connectors.agent.add", "title": "wisp_connector_add", "optimistic": "none" },
      { "id": "connectors.agent.signin", "title": "wisp_connector_signin" }
    ],
    "events": ["connectors.changed", "connectors.works", "connectors.agentAdded"],
    "topics": ["plugin:wisp.connectors:list"]
  }
}
