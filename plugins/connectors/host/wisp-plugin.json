{
  "wispPlugin": 1,
  "id": "wisp.connectors",
  "name": "Connectors",
  "version": "2.0.0",
  "api": "^1",
  "description": "wisp.connectors plugin: wiring to the kernel, store, secrets, proc and HTTP routes",
  "server": {
    "builtin": "wisp-connectors"
  },
  "permissions": [
    "runtime:get"
  ],
  "activation": [
    "onStartup"
  ],
  "contributes": { "events": ["connectors.agent_added", "connectors.changed", "connectors.works"] }
}
