{
  "wispPlugin": 1,
  "id": "wisp.telemetry",
  "name": "Telemetry",
  "version": "2.0.0",
  "api": "^1",
  "description": "Anonymous usage stats and error reports to PostHog (fixed values only, never prompts, paths or code), and the feedback users send the wisp team.",
  "provides": { "telemetry.service": { "version": "1.0.0" } },
  "requires": { "wisp.settings": { "version": "^2", "optional": true }, "wisp.machines": { "version": "^2", "optional": true } },
  "permissions": ["runtime:get", "runtime:turns", "runtime:agents", "runtime:turn.setExt", "machines:call", "net:connect{host:us.i.posthog.com}", "http:route"],
  "server": { "builtin": "./src/index.ts" },
  "activation": ["onStartup"],
  "contributes": {
    "events": ["telemetry.rated"],
    "settings": [
      { "key": "telemetry", "type": "enum", "values": ["on", "off"], "scope": "server" },
      { "key": "telemetry.telemetryNotice", "type": "enum", "values": ["seen"], "scope": "server" }
    ]
  }
}
