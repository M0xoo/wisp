{
  "wispPlugin": 1,
  "id": "wisp.terminal",
  "name": "Terminals",
  "version": "2.0.0",
  "api": "^1",
  "description": "Take over a task in a terminal in the page, a shell beside each task, and opening a task in your terminal app.",
  "server": { "builtin": "@wisp-plugin/terminal" },
  "requires": { "wisp.runtime": "^2" },
  "provides": { "terminal.service": { "version": "1.0.0" } },
  "permissions": ["runtime:get", "proc:spawn", "http:route"],
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "terminal.open", "title": "Open a terminal for a task", "optimistic": "none" },
      { "id": "terminal.input", "title": "Type into a terminal", "optimistic": "none" },
      { "id": "terminal.close", "title": "Close a terminal", "optimistic": "none" },
      { "id": "terminal.shell.start", "title": "Start the shell beside a task", "optimistic": "none" }
    ],
    "events": ["terminal.changed"],
    "points": [{ "id": "terminal.folder", "version": 1, "kind": "list" }],
    "settings": [
      { "key": "terminal", "type": "enum", "values": ["auto", "wisp", "terminal", "iterm", "warp", "cmux", "wt", "powershell", "cmd", "ghostty", "kitty", "wezterm", "gnome-terminal", "konsole", "xfce4-terminal", "alacritty", "xterm", "custom"], "default": "wisp" },
      { "key": "terminal.command", "type": "string", "default": "" }
    ]
  }
}
