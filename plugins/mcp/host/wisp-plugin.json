{
  "wispPlugin": 1,
  "id": "wisp.mcp",
  "name": "MCP server",
  "version": "2.0.0",
  "api": "^1",
  "kind": "plugin",
  "description": "wisp's MCP server: the tools every task's agent gets (ask the user, delegate, My Stuff, the crew, …) and `wisp mcp` for your own editors.",
  "server": { "builtin": "@wisp-plugin/mcp" },
  "requires": { "wisp.runtime": "^2", "agent.tokens": { "version": "^1", "optional": true } },
  "permissions": [
    "http:route",
    "agent:token",
    "runtime:get", "runtime:list", "runtime:create", "runtime:followUp", "runtime:stop",
    "runtime:ask", "runtime:pollAnswer", "runtime:approval", "runtime:delegate", "runtime:results",
    "runtime:agent.*", "runtime:markdown", "runtime:agents",
    "later:agent.*", "ship:agent.*", "watch:agent.*", "stuff:agent.*", "plugins:agent.*",
    "crew:agent.*", "crew:list", "crew:get", "crew:add", "crew:update", "crew:remove", "crew:import",
    "connectors:list", "connectors:add", "connectors:signin",
    "machines:list"
  ],
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "mcp.rpc", "title": "Answer one MCP JSON-RPC message", "optimistic": "none" },
      { "id": "mcp.tools", "title": "The MCP tools a caller is offered", "optimistic": "none" }
    ],
    "points": [
      { "id": "mcp.tool", "version": 1, "kind": "list" },
      { "id": "mcp.session", "version": 1, "kind": "list" }
    ]
  }
}
