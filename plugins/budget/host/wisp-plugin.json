{
  "wispPlugin": 1,
  "id": "wisp.budget",
  "name": "budget",
  "version": "2.0.0",
  "api": "^1",
  "description": "usage windows, Automations stop at, banked resets, the before:run budget guard, compare metrics",
  "kind": "plugin",
  "server": {
    "builtin": "wisp_budget"
  },
  "permissions": [
    "runtime:release",
    "store:write{owner:budget}"
  ],
  "requires": {
    "wisp.runtime": "^2"
  },
  "provides": {},
  "contributes": {
    "settings": [
      { "key": "budget.drainWatch", "type": "bool", "default": false, "title": "Drain watch: tell the phone when a plan moves much faster than usual for the same work" },
      { "key": "budget.windowNotice", "type": "bool", "default": true, "title": "Window notices: say when a usage window changed length or resets early" }
    ],
    "events": ["budget.changed", "budget.drain", "budget.plan_free", "budget.reset", "budget.share"],
    "commands": [
      {
        "id": "budget.view",
        "title": "An account's usage windows",
        "readOnly": true
      },
      {
        "id": "budget.hold",
        "title": "What holds an account's unattended work",
        "readOnly": true
      },
      {
        "id": "budget.record",
        "title": "Record an account's usage windows"
      },
      {
        "id": "budget.dismissDrain",
        "title": "Drain watch: hide an account window's card until a later run shows it again"
      },
      {
        "id": "budget.dismissNotice",
        "title": "Hide a window's notice until that window changes again"
      },
      {
        "id": "budget.setStop",
        "title": "Automations stop at"
      }
    ]
  }
}
