{
  "wispPlugin": 1,
  "id": "wisp.goal",
  "name": "goal",
  "version": "2.0.0",
  "api": "^1",
  "description": "goals: rounds, verdicts, judges, stalls",
  "kind": "plugin",
  "server": {
    "builtin": "wisp_goal"
  },
  "permissions": [
    "runtime:get",
    "runtime:turns",
    "sandbox:place",
    "machines:route",
    "runtime:profiles",
    "runtime:quick",
    "runtime:setExt",
    "runtime:followUp",
    "runtime:ask"
  ],
  "requires": {},
  "provides": {},
  "contributes": {
    "events": [{"type": "goal.met", "durable": true}, {"type": "goal.failed", "durable": true}],
    "commands": [
      { "id": "goal.set", "title": "Set, change or clear a task's goal" },
      { "id": "goal.pause", "title": "Pause a task's goal: no judging until it resumes" },
      { "id": "goal.resume", "title": "Resume a task's paused goal" },
      { "id": "goal.drop", "title": "Drop a task's goal" },
      { "id": "goal.check", "title": "Judge a task's goal now, on its last answer" }
    ]
  },
  "activation": [
    "onStartup"
  ]
}
