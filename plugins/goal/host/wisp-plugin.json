{
  "wispPlugin": 1,
  "id": "wisp.goal",
  "name": "goal",
  "version": "2.0.0",
  "api": "^1",
  "description": "goals: rounds, verdicts, judges, stalls",
  "kind": "plugin",
  "server": {
    "builtin": "wisp_goal"
  },
  "permissions": [
    "runtime:get",
    "runtime:turns",
    "runtime:profiles",
    "runtime:quick",
    "runtime:setExt",
    "runtime:followUp",
    "runtime:ask"
  ],
  "requires": {},
  "provides": {},
  "contributes": { "events": [{"type": "goal.met", "durable": true}, {"type": "goal.failed", "durable": true}] },
  "activation": [
    "onStartup"
  ]
}
