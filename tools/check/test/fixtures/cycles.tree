Cycles: a ↔ b between packages (one edge declared, one imported), a.ts → b.ts → c.ts → a.ts inside one,
a type-only loop that is fine, a dynamic import that is fine, and a self-import.
=== packages/a/package.json
{ "name": "@f/a", "exports": { ".": "./src/index.ts" }, "dependencies": { "@f/b": "*" } }
=== packages/a/src/index.ts
export const a = 1;
=== packages/b/package.json
{ "name": "@f/b", "exports": { ".": "./src/index.ts" } }
=== packages/b/src/index.ts
import { a } from '@f/a';
export const b = a;
=== packages/c/package.json
{ "name": "@f/c", "exports": { ".": "./src/a.ts" } }
=== packages/c/src/a.ts
