Manifests: the kernel's validator, unique ids, default deny, versioned points, mapped service methods.
=== packages/kernel/package.json
{ "name": "@f/kernel", "type": "module", "exports": { ".": "./src/index.ts" } }
=== packages/kernel/src/index.ts
export function validateManifest(m: unknown): { ok: true } | { ok: false; errors: string[] } {
  const r = m as { name?: unknown };
  return typeof r.name === 'string' ? { ok: true } : { ok: false, errors: ['name: required'] };
}
=== packages/kernel/src/capabilities.ts
const USER = { id: 'user:full', allow: ['*'] };
const AGENT = { id: 'agent:session', allow: ['git:*', 'wt.list'], deny: [{ permission: 'wt:open{scope:workspace}', why: 'wt.remove is described here, in prose only' }] };
const CAPPED = { id: 'agent:capped', allow: [`git.status`] };
export const SETS = [USER, AGENT, CAPPED];
