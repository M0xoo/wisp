=== plugins/git/api/src/index.ts
import { defineService, type ServiceRef } from '@f/kernel';
export interface GitService {
  status(): Promise<string>;
  push: (branch: string) => Promise<void>;
  readonly root: string;
}
export const gitService = defineService<GitService>({ id: 'git.service', major: 1, permissions: { status: 'git:status' } });
interface Base { remove(): void }
export interface WtService extends Base { list(): string[] }
export const wtService: ServiceRef<WtService> = { id: 'wt.service', major: 1, permissions: { list: 'wt:list', extra: 'wt:extra' } };
export const okService = { id: 'ok.service', major: 1, permissions: { remove: 'wt:remove' } } satisfies ServiceRef<Base>;
export const dynamic = defineService<Base>({ id: 'dyn.service', major: 1, permissions: makePerms() });
export const positional = defineService<WtService>('pos.service', 1, { list: 'wt:list', remove: 'wt:remove' });
export const positionalBad = defineService<Base>('pos.bad', 1, {});
