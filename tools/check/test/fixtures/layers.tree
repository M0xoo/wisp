Layers: packages ← plugin api ← plugin host/ui ← apps, node: kept out of page and api code.
=== packages/base/package.json
{ "name": "@f/base", "exports": { ".": "./src/index.ts" } }
=== packages/base/src/index.ts
import { gitCommands } from '@f/git-api';
export const base = gitCommands;
