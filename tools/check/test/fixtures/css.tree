import './panel.css';
const w = 3;
export const A = () => <div class="x" />;
export const B = () => <div className="x" />;
export const C = () => <div style="color: red" />;
export const D = () => <div style={{ color: 'red', '--w': w }} />;
export const E = () => <div style={{ '--sb-w': `${w}px`, '--h': w }} />;
export const F = () => <div style={styles} />;
const styles = { '--x': 1 };
