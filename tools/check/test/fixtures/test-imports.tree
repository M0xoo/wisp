{ "name": "@wisp/ui", "exports": { ".": "./src/index.ts", "./pure": "./src/pure.ts" } }
=== packages/ui/src/index.ts
export { Button } from './Button.tsx';
export { plain } from './plain.ts';
=== packages/ui/src/Button.tsx
