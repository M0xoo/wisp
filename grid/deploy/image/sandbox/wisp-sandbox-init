#!/bin/sh
# A sandbox's first process (boxd starts sandboxes as root, under gVisor only: grid/boxd.js). It
# starts the root helper (wisp-rootd: what `sudo` talks to), then runs wisp as the box's user. gVisor
# doesn't honour setuid binaries, so sudo can't be one; root is gVisor's, not the host's.
set -e
mkdir -p /run/wisp
chmod 755 /run/wisp
# Kept running (set +e: the script's set -e would end the loop the first time it exits): sudo has nothing to talk to without it.
(set +e; while :; do node /usr/local/lib/wisp/rootd.mjs; sleep 1; done) &
i=0
while [ ! -S /run/wisp/root.sock ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
exec setpriv --reuid=1000 --regid=1000 --init-groups -- "$@"
