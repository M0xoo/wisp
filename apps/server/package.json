{
  "name": "wisp-agents",
  "version": "2.0.0-alpha.0",
  "description": "Run Claude Code, Codex, Cursor and other coding agents in parallel, in the background, on any of your machines. Skip the transcript, read the report.",
  "type": "module",
  "private": false,
  "bin": {
    "wisp": "bin/wisp.ts",
    "wisp-agents": "bin/wisp.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "author": "M0xoo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M0xoo/wisp.git"
  },
  "homepage": "https://trywisp.dev",
  "dependencies": {
    "@wisp/kernel": "*",
    "@wisp/protocol": "*",
    "@wisp/store": "*",
    "@wisp/sync": "*",
    "@wisp-plugin/server-api": "*"
  },
  "devDependencies": {},
  "scripts": {
    "test": "node --test --test-reporter=dot \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
